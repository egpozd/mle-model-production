FROM python:3.10-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OMP_NUM_THREADS=2
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY services/ml_service services/ml_service
COPY services/models services/models
COPY example.json .
USER 10001
EXPOSE 8000
CMD ["uvicorn", "services.ml_service.app:app", "--host", "0.0.0.0", "--port", "8000"]
